{
  "name": "escrow-marketplace",
  "version": "0.1.0",
  "private": true,
  "description": "Decentralized second-hand marketplace with ETH escrow",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "ganache": "node scripts/start-ganache.js",
    "deploy:ganache": "hardhat run scripts/deploy-empty.js --network ganache",
    "dev": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "test:frontend": "npm --prefix frontend test"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "2.1.2",
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "chai": "4.5.0",
    "dotenv": "16.6.1",
    "ethers": "6.15.0",
    "ganache": "7.9.2",
    "hardhat": "2.28.6"
  }
}
